# Telegram
BOT_TOKEN=your_telegram_bot_token_here
ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/staging_bot

# Redis
REDIS_URL=redis://localhost:6379/0

# AI image generation (Replicate / Stability AI / OpenAI DALL-E …)
AI_PROVIDER=replicate
AI_API_KEY=your_ai_api_key_here
AI_MODEL=stability-ai/sdxl:latest

# Vision / photo analysis (ТЗ §13.2). Uses an OpenAI-compatible
# /chat/completions endpoint. Leave VISION_API_KEY empty to skip analysis
# (the bot will still generate images, just without per-room hints).
VISION_PROVIDER=openai
VISION_API_KEY=
VISION_MODEL=gpt-4o-mini
VISION_BASE_URL=https://api.openai.com/v1
VISION_TIMEOUT_SECONDS=30

# Storage (S3-compatible)
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_BUCKET_NAME=staging-bot-files
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=eu-central-1

# Payments (Telegram Payments or external)
PAYMENT_PROVIDER=telegram
PAYMENT_TOKEN=your_payment_token_here

# Tariff prices (in smallest currency unit, e.g. kopecks)
PRICE_ROOM=49900
PRICE_PRO_ROOM=99900
PRICE_FLAT=199900
PRICE_REALTOR_PACK=299900

# App settings
DEBUG=false
LOG_LEVEL=INFO
FREE_PREVIEWS_LIMIT=1
MAX_ACTIVE_PROJECTS=3
MAX_PHOTO_SIZE_MB=10
WATERMARK_PATH=app/assets/watermark.png

# Webhook (production)
WEBHOOK_HOST=https://your-domain.com
WEBHOOK_PATH=/webhook
